rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation Helpers (Strict Keys, Bounds, Types)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoUrl', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 320 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidFlockDocument(data) {
      return data.keys().hasAll(['userId', 'flockDataJson', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'flockDataJson', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.flockDataJson is string && data.flockDataJson.size() <= 800000 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // PII Isolation: No listing across all users
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: User's Homestead Flock Records
      match /flockData/{docId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidFlockDocument(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidFlockDocument(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }
    }
  }
}
