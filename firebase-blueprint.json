{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile for Flocker",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "email",
        "createdAt"
      ]
    },
    "FlockDocument": {
      "title": "FlockDocument",
      "description": "Encapsulated homestead flock ledger dataset for an authenticated user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "flockDataJson": {
          "type": "string",
          "maxLength": 800000
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "userId",
        "flockDataJson",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private profile of the authenticated poultry manager"
    },
    "/users/{userId}/flockData/{docId}": {
      "schema": {
        "$ref": "#/entities/FlockDocument"
      },
      "description": "Synchronized poultry, coop, egg, inventory and health records for the user"
    }
  }
}
