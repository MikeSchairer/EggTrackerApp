# Firebase app configuration
# Copy this file to `.env.local` and fill in the values for your Firebase project.
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:your-app-id"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_OAUTH_CLIENT_ID="your-google-oauth-client-id"
VITE_FIREBASE_RECAPTCHA_SITE_KEY=""

# Gemini / app settings
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
